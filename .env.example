# ---------------------------------------------------------------
# Download stack — single source of configuration
# ---------------------------------------------------------------

# Compose project name (prefix for containers/networks)
COMPOSE_PROJECT_NAME=download-stack

# User/group the containers run as (run `id -u` / `id -g`)
PUID=501
PGID=20

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Amsterdam

# File creation mask (002 = group-writable)
UMASK=002

# ---------------------------------------------------------------
# Paths
# ---------------------------------------------------------------
# Where each app stores its config/database
CONFIG_ROOT=./config

# Shared data root. Downloads and media live under ONE mount so
# Radarr/Sonarr can hardlink/atomic-move instead of copying.
#   ${DATA_ROOT}/usenet/{incomplete,complete}
#   ${DATA_ROOT}/media/{movies,tv}
DATA_ROOT=./data

# ---------------------------------------------------------------
# Image tags
# ---------------------------------------------------------------
SABNZBD_TAG=latest
RADARR_TAG=latest
SONARR_TAG=latest
PROWLARR_TAG=latest
SEERR_TAG=latest

# Seerr log level: debug, info, warn, error
SEERR_LOG_LEVEL=info

# ---------------------------------------------------------------
# Host ports (web UI)
# ---------------------------------------------------------------
SABNZBD_PORT=8080
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
SEERR_PORT=5055
