# ---------------------------------------------------------------
# Download stack — single source of configuration
# ---------------------------------------------------------------

# Compose project name (prefix for containers/networks)
COMPOSE_PROJECT_NAME=download-stack

# User/group the containers run as (run `id -u` / `id -g`)
PUID=501
PGID=20

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Amsterdam

# File creation mask (002 = group-writable)
UMASK=002

# ---------------------------------------------------------------
# Paths
# ---------------------------------------------------------------
# Where each app stores its config/database
CONFIG_ROOT=./config

# Shared data root. Downloads and media live under ONE mount so
# Radarr/Sonarr can hardlink/atomic-move instead of copying.
#   ${DATA_ROOT}/usenet/{incomplete,complete}
#   ${DATA_ROOT}/media/{movies,tv}
DATA_ROOT=./data

# ---------------------------------------------------------------
# Image tags
# ---------------------------------------------------------------
SABNZBD_TAG=latest
RADARR_TAG=latest
SONARR_TAG=latest
PROWLARR_TAG=latest
UPTIME_KUMA_TAG=2
DOZZLE_TAG=latest
BAZARR_TAG=latest
JELLYFIN_TAG=latest
SEERR_TAG=latest
# Recyclarr: stay on major version 8 (config format changes between majors)
RECYCLARR_TAG=8

# Seerr log level: debug, info, warn, error
SEERR_LOG_LEVEL=info

# ---------------------------------------------------------------
# Host ports (web UI)
# ---------------------------------------------------------------
SABNZBD_PORT=8080
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
UPTIME_KUMA_PORT=3001
# Dozzle listens on 8080 inside the container; 8888 avoids a clash with SABnzbd
DOZZLE_PORT=8888
BAZARR_PORT=6767
JELLYFIN_PORT=8096
SEERR_PORT=5055

# ---------------------------------------------------------------
# Recyclarr (TRaSH Guides sync)
# ---------------------------------------------------------------
# Cron schedule, e.g. @daily, @weekly or "0 4 * * *"
RECYCLARR_SCHEDULE=@daily
# Paste the API keys from Radarr/Sonarr (Settings -> General) after first setup
RADARR_API_KEY=
SONARR_API_KEY=

# ---------------------------------------------------------------
# Backups (backup.sh)
# ---------------------------------------------------------------
# Where backups are written, and how many to keep
BACKUP_DIR=./backups
BACKUP_KEEP=7
